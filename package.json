{
  "name": "career-app",
  "version": "1.0.0",
  "description": "Local desktop app for tracking learning interests and generating daily prompts.",
  "author": "Jon",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/worker",
    "test": "node --import ./scripts/test-hooks.mjs --test \"src/**/*.test.ts\"",
    "build:win": "electron-vite build && electron-builder --win",
    "build:web": "vite build --config vite.web.config.ts",
    "dev:web": "npm run build:web && wrangler dev",
    "deploy": "npm run build:web && wrangler deploy",
    "build:android": "npm run build:web && cap sync android && cd android && .\\gradlew.bat assembleRelease",
    "install:android": "\"%LOCALAPPDATA%/Android/Sdk/platform-tools/adb.exe\" install -r android/app/build/outputs/apk/release/app-release.apk"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.2",
    "@chakra-ui/react": "^3.37.0",
    "@cloudflare/workers-types": "^5.20260929.1",
    "@emotion/react": "^11.14.0",
    "@fontsource-variable/archivo": "^5.3.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "motion": "^13.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.5.0",
    "typescript": "^5.7.0",
    "vite": "^7.3.6",
    "wrangler": "^4.143.1",
    "zustand": "^5.0.15"
  }
}
